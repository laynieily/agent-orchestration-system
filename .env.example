OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Used for every agent role (planner/specialist/reviewer) when the matching
# API key above is set -- get_llm() doesn't route roles to different models.
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o-mini

REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/agent_orchestrator
CHROMA_PERSIST_DIR=./data/chroma

PLAN_CONFIDENCE_THRESHOLD=0.45
REVIEW_QUALITY_THRESHOLD=0.6
MAX_SUBTASK_RETRIES=3